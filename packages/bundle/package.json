{
  "name": "@perf-trail/bundle",
  "version": "0.0.0",
  "description": "Bundle size adapters for perf-trail: Next.js, Vite and glob",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvffblvde/perf-trail.git",
    "directory": "packages/bundle"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@perf-trail/core": "workspace:*"
  }
}
