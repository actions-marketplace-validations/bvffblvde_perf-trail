ircle></g></svg><figcaption>LCP went from 1.8 s to 2.05 s over 6 deploys, best 1.8 s. 1 of 6 outside the 2.5 s budget.</figcaption></figure>"`;

exports[`PerfHistoryChart > renders a single point 1`] = `"<figure class="pt-chart" data-metric="lcp"><svg viewBox="0 0 640 240" role="img" aria-labelledby="pt-lcp-root-mobile-title pt-lcp-root-mobile-desc"><title id="pt-lcp-root-mobile-title">LCP on /</title><desc id="pt-lcp-root-mobile-desc">LCP 1.4 s on the only measured deploy.</desc><g class="pt-grid"><g><line x1="52" x2="624" y1="210" y2="210"></line><text x="44" y="210" dy="0.32em" text-anchor="end">0 s</text></g><g><line x1="52" x2="624" y1="145.3" y2="145.3"></line><text x="44" y="145.3" dy="0.32em" text-anchor="end">0.5 s</text></g><g><line x1="52" x2="624" y1="80.7" y2="80.7"></line><text x="44" y="80.7" dy="0.32em" text-anchor="end">1 s</text></g><g><line x1="52" x2="624" y1="16" y2="16"></line><text x="44" y="16" dy="0.32em" text-anchor="end">1.5 s</text></g></g><g class="pt-axis"><text x="338" y="232" text-anchor="middle">00f4240</text></g><path class="pt-line" d="M338 28.9"></path><g class="pt-points"><circle class="pt-point pt-last" cx="338" cy="28.9" r="4.5"><title>00f4240, 2026-01-01: 1.4 s</title></circle></g></svg><figcaption>LCP 1.4 s on the only measured deploy.</figcaption></figure>"`;

