exports[`PerfHistoryChart > renders an empty state with an accessible name 1`] = `"<figure class="pt-chart" data-metric="lcp"><svg viewBox="0 0 640 240" role="img" aria-labelledby="pt-lcp-root-mobile-title pt-lcp-root-mobile-desc" style="max-width:640px"><title id="pt-lcp-root-mobile-title">LCP on /</title><desc id="pt-lcp-root-mobile-desc">LCP: No deploys measured yet.</desc><text class="pt-empty" x="320" y="120" text-anchor="middle">No deploys measured yet</text></svg><figcaption>LCP: No deploys measured yet.</figcaption></figure>"`;
